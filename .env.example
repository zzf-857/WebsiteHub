# Next.js server-side proxy target. Keep FastAPI on loopback for the Windows LAN MVP.
# Production rewrites are fixed during `pnpm build`; build and start with the same value.
WEBHUB_API_INTERNAL_URL=http://127.0.0.1:8100

# Optional comma-separated aliases in addition to detected loopback/LAN IPs and the machine name.
WEBHUB_ALLOWED_HOSTS=

# FastAPI runtime. Relative data paths resolve from the repository root.
WEBHUB_DATA_DIR=.data
WEBHUB_ENVIRONMENT=development

# Optional SQLAlchemy URL. When omitted, WebHub uses <WEBHUB_DATA_DIR>/main.sqlite3.
# WEBHUB_DATABASE_URL=sqlite+aiosqlite:///F:/absolute/path/to/main.sqlite3

# Comma-separated additional browser origins allowed to perform authenticated writes.
WEBHUB_ALLOWED_ORIGINS=

# Keep false for trusted-LAN HTTP. Set true only when the website is served over HTTPS.
WEBHUB_SESSION_COOKIE_SECURE=false
