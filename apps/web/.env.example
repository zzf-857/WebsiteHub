# Next.js proxies /api/backend/* to this internal FastAPI origin.
# Production rewrites are fixed during `pnpm build`; build and start with the same value.
WEBHUB_API_INTERNAL_URL=http://127.0.0.1:8100

# Optional aliases in addition to detected loopback/LAN IPs and the machine name.
WEBHUB_ALLOWED_HOSTS=

# Comma-separated hostnames/IPs allowed to load Next.js development resources.
WEBHUB_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
