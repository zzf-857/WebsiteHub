# WebHub 服务器部署配置样例（Q49）。复制为 deploy/.env（已被 Git 与 Docker 构建上下文忽略）再填写：
#   cp deploy/.env.production.example deploy/.env && chmod 600 deploy/.env
# compose.yaml 以 env_file 读取本文件；值按字面量读取，不要加引号。
# 以下 <机器>.<tailnet>.ts.net 换成 `tailscale status --json | jq -r .Self.DNSName`（去掉末尾的点）
# 或 Tailscale 管理后台 Machines 页显示的完整域名，例如 webhub.tail1234.ts.net。
#
# 不要在这里设置 WEBHUB_DATA_DIR / WEBHUB_API_INTERNAL_URL / WEBHUB_DATABASE_URL：前两项由 compose.yaml
# 固定为 /data 与 http://127.0.0.1:8100（单容器不变量），数据库默认就是 /data/main.sqlite3。

WEBHUB_ENVIRONMENT=production

# Provider API Key 的 AES-256-GCM 主密钥：32 字节随机数的 Base64。生产环境缺失时容器拒绝启动。
# 生成（任选一条，只生成一次）：
#   openssl rand -base64 32
#   python3 -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 必须与数据库一起备份（deploy/backup.sh 会一并打包）：丢失后库里已保存的 Provider API Key 永久无法解密；
# 中途更换也会让已保存的 Key 全部失效。
WEBHUB_PROVIDER_MASTER_KEY=
WEBHUB_PROVIDER_MASTER_KEY_VERSION=1

# 网站入口额外允许的 Host（逗号分隔）。localhost / 127.0.0.1 / 容器自身地址已默认允许，
# 同机 bot 用 http://127.0.0.1:3100 不需要配置；经 tailscale serve 访问必须写上 tailnet 域名。
WEBHUB_ALLOWED_HOSTS=<机器>.<tailnet>.ts.net

# 允许执行登录态写操作的浏览器 Origin（逗号分隔，含协议，不带路径）。tailscale serve 转发时保留原 Host，
# 网站据此写入 X-Forwarded-Host，同源校验本身就能通过（已按这种转发方式模拟验证注册与登录态写入），
# 严格说可以留空；这里仍显式列出 https 源，避免以后换成改写 Host 的反向代理时网页上的登录、保存一律 403。
WEBHUB_ALLOWED_ORIGINS=https://<机器>.<tailnet>.ts.net

# 网站经 tailscale serve 以 HTTPS 提供，登录 Cookie 只走 HTTPS。
# 浏览器把 http://127.0.0.1 / http://localhost 视为安全上下文，经 SSH 端口转发访问仍能登录。
WEBHUB_SESSION_COOKIE_SECURE=true
